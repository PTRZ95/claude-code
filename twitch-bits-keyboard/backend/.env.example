# Twitch Extension Einstellungen
# Findest du unter https://dev.twitch.tv/console/extensions
TWITCH_EXTENSION_SECRET=dein_base64_extension_secret
TWITCH_EXTENSION_CLIENT_ID=deine_extension_client_id
TWITCH_OWNER_ID=deine_twitch_user_id

# Server
PORT=3000

# Sicherheits-Token fuer den Desktop-Client
DESKTOP_CLIENT_TOKEN=ein_sicheres_zufaelliges_token_hier
