# ===========================================
# Twitch Live Subtitles - Konfiguration
# ===========================================
# Kopiere diese Datei zu .env und passe die Werte an.

# --- Audio / Mikrofon ---
AUDIO_DEVICE=default
SAMPLE_RATE=16000

# --- Vosk Speech-to-Text ---
# Pfad zum heruntergeladenen Vosk-Modell (deutsch)
# Modell herunterladen: npm run download-model
VOSK_MODEL_PATH=./models/vosk-model-small-de-0.15
SOURCE_LANGUAGE=de

# --- LibreTranslate ---
# Eigene Instanz: docker run -d -p 5000:5000 libretranslate/libretranslate
# Oder oeffentliche Instanz verwenden
LIBRETRANSLATE_URL=http://localhost:5000
LIBRETRANSLATE_API_KEY=

# --- Server ---
PORT=3000
HOST=0.0.0.0

# --- Twitch Bot ---
# Twitch Bot-Account Benutzername
TWITCH_BOT_USERNAME=mein_subtitle_bot
# OAuth Token: https://twitchapps.com/tmi/
TWITCH_OAUTH_TOKEN=oauth:dein_token_hier
# Dein Twitch-Kanalname
TWITCH_CHANNEL=dein_kanal

# --- Untertitel-Anzeige ---
SUBTITLE_DISPLAY_DURATION_MS=6000
MAX_SUBTITLE_LENGTH=250
